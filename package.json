{
  "name": "employee-management-system",
  "version": "1.0.0",
  "description": "نظام إدارة موظفين متكامل — حضور وانصراف بنظام GPS، أجور، مصروفات، وتتبّع أجهزة تسجيل الدخول",
  "license": "MIT",
  "author": {
    "name": "EMS contributors"
  },
  "keywords": [
    "employee-management",
    "attendance",
    "gps-attendance",
    "payroll",
    "expenses",
    "device-fingerprint",
    "express",
    "vanilla-js",
    "postgresql",
    "sqlite",
    "firebase",
    "firestore",
    "rtl",
    "arabic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/employee-management.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/employee-management/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/employee-management#readme",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=18 <25",
    "npm": ">=9"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "setup": "npm run db:migrate && npm run db:seed",
    "test:api": "node tests/api.test.js",
    "reset": "node server/db/reset.js",
    "test:front": "node tests/front.check.js",
    "test": "npm run test:api && npm run test:front && npm run test:shapes && npm run test:firebase",
    "test:shapes": "node tests/shapes.check.js",
    "test:offline": "node tests/offline.check.js",
    "db:doctor": "node server/db/doctor.js",
    "build:firebase": "node tools/build-firebase.js",
    "test:firebase": "node tests/firebase.check.js",
    "test:firebase:dom": "node tests/offline.check.js ems-firebase.html",
    "github:check": "node tools/build-firebase.js && git diff --exit-code -- ems-firebase.html deploy-firebase",
    "shots": "node tools/screenshots.js",
    "check:single": "node tools/check-selfcontained.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@neon/config": "^1.3.1",
    "@neon/env": "^1.2.2"
  }
}
